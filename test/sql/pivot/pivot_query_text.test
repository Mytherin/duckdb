# name: test/sql/pivot/pivot_query_text.test
# description: current_query() inside a PIVOT reports the query the user issued
# group: [pivot]

statement ok
CREATE TABLE t(c VARCHAR, v INTEGER);

statement ok
INSERT INTO t VALUES ('a', 1), ('b', 2);

statement ok
CREATE TABLE captured AS
PIVOT (SELECT c, v, current_query() AS q FROM t) ON c USING ANY_VALUE(q) ORDER BY v;

# a PIVOT is rewritten into a multi-statement, but that multi-statement is executed as a single
# query - so current_query() reports the original query text, not the rewritten sub-statement
query III
SELECT v,
       trim(regexp_replace(a, '\s+', ' ', 'g')) AS a,
       trim(regexp_replace(b, '\s+', ' ', 'g')) AS b
FROM captured ORDER BY v;
----
1	CREATE TABLE captured AS PIVOT (SELECT c, v, current_query() AS q FROM t) ON c USING ANY_VALUE(q) ORDER BY v;	NULL
2	NULL	CREATE TABLE captured AS PIVOT (SELECT c, v, current_query() AS q FROM t) ON c USING ANY_VALUE(q) ORDER BY v;
