# name: test/sql/storage/wal/wal_replay_attached_type.test
# description: Replay a WAL that references a user defined type of the attached database
# group: [wal]

load __TEST_DIR__/wal_replay_attached_type.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB'

statement ok
CREATE TYPE mood AS ENUM ('ok', 'sad')

statement ok
CREATE TABLE t(m VARCHAR)

statement ok
INSERT INTO t VALUES ('ok')

statement ok
ALTER TABLE t ALTER m TYPE mood

# replay the WAL as the initial database
restart

query I
SELECT typeof(m) FROM t
----
ENUM('ok', 'sad')

# now replay the same WAL as a secondary attached database
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
PRAGMA wal_autocheckpoint='1TB'

statement ok
ALTER TABLE t ALTER m TYPE VARCHAR

statement ok
ALTER TABLE t ALTER m TYPE mood

load :memory:

statement ok
ATTACH '__TEST_DIR__/wal_replay_attached_type.db' AS attached

query I
SELECT typeof(m) FROM attached.t
----
ENUM('ok', 'sad')
